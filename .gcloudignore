# Never upload secrets or local environments to Google Cloud.
.env
.env.*
!.env.example
.venv/
venv/
.git/
# Ship the pre-downloaded listing photos (backend/listing_photos.py) so the hosted site
# doesn't depend on provider websites; skip any other local caches.
.cache/*
!.cache/listing-photos/
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/

# The Gemma GPU image is built separately (see gemma/README.md)
gemma/

# The explainer video isn't part of the site
video/
